# Copie ce fichier en .env et remplis les vraies valeurs.
# NE JAMAIS commiter le fichier .env reel. NE JAMAIS mettre de vraies cles API.
# Ce projet est un simulateur, aucune connexion bancaire reelle.

# Base de donnees PostgreSQL
POSTGRES_DB=mywallet
POSTGRES_USER=mywallet
POSTGRES_PASSWORD=change-me

# Redis (cache des sessions et rate limiter)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ (bus de messages pour les cours de bourse)
RABBITMQ_USER=mywallet
RABBITMQ_PASSWORD=change-me

# JWT - secret de signature des tokens
# Pour generer un secret solide : openssl rand -base64 64
JWT_SECRET=change-me-generate-a-real-64-byte-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Frontend - URL de l'API backend
VITE_API_BASE_URL=http://localhost:8080

# Grafana (surveillance locale uniquement)
GRAFANA_ADMIN_PASSWORD=change-me

# Mode demo (pour docker-compose.prod-lite.yml seulement)
DEMO_MODE_ENABLED=false
# Heure de remise a zero des donnees de demo (par defaut toutes les 6 heures)
DEMO_RESET_CRON=0 */6 * * *
